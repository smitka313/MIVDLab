# ClassPulse environment configuration
# Copy to .env.local and fill in. Leave both blank to run in browser-only DEMO MODE.

# Supabase project URL and the public "anon" key (Project Settings -> API).
# The anon key is safe to expose to the browser; all data access is enforced by
# row-level security in the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the Supabase service-role key in a NEXT_PUBLIC_ variable, and never
# commit it. ClassPulse application code does not use it.

# Optional: only for `npm run test:db` (PostgreSQL superuser connection used to
# create a throwaway database and apply the migrations).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
